[Unit]
Description=BiliRecord2K live recording service
Documentation=https://github.com/Metahumanz/LiveRecord2k
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bili-record-2k
Group=bili-record-2k
Environment=NODE_ENV=production
Environment=BILI_RECORD_NO_OPEN=1
Environment=BILI_RECORD_APP_ROOT=/usr/lib/bili-record-2k
Environment=BILI_RECORD_SERVER_ENTRY=/usr/lib/bili-record-2k/server.bundle.cjs
EnvironmentFile=-/etc/bili-record-2k/environment
ExecStart=/usr/lib/bili-record-2k/bin/node /usr/lib/bili-record-2k/server.bundle.cjs --prod --no-open
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
StateDirectory=bili-record-2k
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
